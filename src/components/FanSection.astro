---
import { getText } from "@/lib/i18n";
import type { FanHub, FanInfo, FanSubmission, Locale } from "@/types/content";
import type { Messages } from "@/i18n/messages";

interface Props {
  locale: Locale;
  fanInfo: FanInfo;
  fanHub: FanHub;
  submissions: FanSubmission[];
  messages: Messages;
}

const { locale, fanInfo, fanHub, submissions, messages } = Astro.props;

function isValidContributeUrl(url: string): boolean {
  try {
    const parsed = new URL(url);
    return parsed.protocol === "https:" || parsed.protocol === "http:" ||
      (parsed.protocol === "mailto:" && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(parsed.pathname));
  } catch {
    return false;
  }
}

const faqItems = fanHub.faq.filter((item) => item.q?.zh && item.a?.zh);
const contributeUrl = isValidContributeUrl(fanHub.contribute.url) ? fanHub.contribute.url : "";
const contributeIsEmail = contributeUrl.startsWith("mailto:");
---

<section class="section shell">
  <div class="fan-hub-stack">
    <div class="card fan-card">
      <h2>{messages.sections.fan}</h2>
      <p>{getText(fanInfo.intro, locale)}</p>
      <p>
        <strong>{messages.common.qqGroup}:</strong>
        <span class="qq-number">{fanInfo.qqGroupId}</span>
      </p>
    </div>

    {
      submissions.length > 0 && (
        <section class="fan-submissions" aria-labelledby="fan-submissions-title">
          <h2 id="fan-submissions-title">{messages.sections.fanSubmissions}</h2>
          {submissions.map((submission) => (
            <article class="card fan-hub-card fan-submission" id={submission.id}>
              <div class="fan-submission-meta">
                <h3 class="fan-submission-floor">{submission.floor}#</h3>
                <p>{messages.common.submittedBy}{submission.author}</p>
              </div>
              <p class="fan-submission-content">{submission.content}</p>
              <div class="fan-submission-images">
                {submission.images.map((image) => (
                  <a href={image.src} target="_blank" rel="noopener noreferrer">
                    <img src={image.src} alt={getText(image.alt, locale)} width={image.width} height={image.height} loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            </article>
          ))}
        </section>
      )
    }

    <div class="card fan-hub-card">
      <h3>{messages.sections.fanDisclaimer}</h3>
      <p>{getText(fanHub.disclaimer, locale) || messages.common.fanMadeNotice}</p>
    </div>

    <div class="card fan-hub-card">
      <h3>{messages.sections.fanFaq}</h3>
      {
        faqItems.length ? (
          <dl class="fan-faq-list">
            {
              faqItems.map((item) => (
                <>
                  <dt>{getText(item.q, locale)}</dt>
                  <dd>{getText(item.a, locale)}</dd>
                </>
              ))
            }
          </dl>
        ) : (
          <p>{messages.common.faqEmpty}</p>
        )
      }
    </div>

    <div class="card fan-hub-card">
      <h3>{messages.sections.fanContribute}</h3>
      <p>{messages.common.submitVia}</p>
      {
        contributeUrl ? (
          <a href={contributeUrl} target={contributeIsEmail ? undefined : "_blank"} rel={contributeIsEmail ? undefined : "noopener noreferrer"} class="btn btn-primary fan-contribute-link">
            {fanHub.contribute.label}
          </a>
        ) : (
          <p>{messages.common.noLink}</p>
        )
      }
    </div>
  </div>
</section>
